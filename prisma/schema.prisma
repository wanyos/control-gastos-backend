// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ─────────────────────────────────────────────────
// No `cash` account type: cash is seen through the bank movements (ATM
// withdrawals), there is no cash account (see docs/architecture.md ADR-011).
enum AccountType {
  checking
  savings
}

enum CategoryKind {
  expense
  income
}

// No `transfer` value: a transfer between own accounts is two ordinary
// movements already reported by each bank, linked by `Movement.transferId`.
// `neutral` covers a zero amount (neither income nor expense).
enum MovementType {
  expense
  income
  neutral
}

enum PaymentMethod {
  card
  cash
  bank_transfer
  direct_debit
}

// `manual` has no producer today; it is what keeps the dedup index PARTIAL
// (WHERE origin = 'imported') without having to rebuild it later.
enum MovementOrigin {
  imported
  manual
}

enum MovementStatus {
  confirmed
  pending_review
}

// `fund`, `etf` and `managed_portfolio` carry exactly the same fields: a
// managed portfolio is one product with its total value, never broken down
// into what it holds. `deposit` is the only one with a specific part
// (see docs/architecture.md ADR-012).
enum InvestmentProductType {
  fund
  etf
  managed_portfolio
  deposit
  // Feature 26: a remunerated account does not fluctuate and nothing is
  // invested in it; it grows with the interest paid into it, so its monthly
  // photo is a SavingsSnapshot and never a Valuation (ADR-026).
  savings_account
}

// Feature 48: the state of a warning left by an import. Only the human gives
// one for reviewed: a mismatch since feature 48, and a row the parser could not
// read since feature 54.
enum ImportWarningStatus {
  pending
  reviewed
}

// ── Models ────────────────────────────────────────────────
model Account {
  id                       Int                     @id @default(autoincrement())
  iban                     String                  @unique
  bank                     String
  alias                    String
  type                     AccountType             @default(checking)
  initialBalance           Decimal                 @default(0) @db.Decimal(10, 2)
  /// Feature 31: the balance the statement stated, kept as a FACT, with the
  /// point in history it belongs to. NULL = never anchored. Amount and date are
  /// both NULL or both set (CHECK Account_balance_anchor_pair).
  balanceAnchor            Decimal?                @db.Decimal(10, 2)
  balanceAnchorDate        DateTime?               @db.Date
  /// Position within that day, to break ties. NULL when the bank gives none.
  balanceAnchorDaySequence Int?
  movements                Movement[]
  importBalanceMismatches  ImportBalanceMismatch[]
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
}

model Category {
  id        Int            @id @default(autoincrement())
  name      String
  kind      CategoryKind
  parent    Category?      @relation("Subcategories", fields: [parentId], references: [id])
  parentId  Int?
  children  Category[]     @relation("Subcategories")
  movements Movement[]
  rules     CategoryRule[]
  createdAt DateTime       @default(now())

  // Re-created as NULLS NOT DISTINCT in the migration so two root categories
  // (parentId IS NULL) with the same kind and name cannot coexist.
  @@unique([parentId, kind, name])
}

/// One auto-categorization rule (feature 43): when a movement's description
/// CONTAINS `matchText` (both normalized) and the category's kind matches the
/// movement's type, the categorization run writes `categoryId` on it. FK left
/// as the default `Restrict` on purpose: the friendly 409 lives in
/// `deleteCategory` (R16).
model CategoryRule {
  id         Int      @id @default(autoincrement())
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  /// Stored ALREADY normalized (lowercase, no diacritics, trimmed).
  matchText  String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Movement {
  id                Int          @id @default(autoincrement())
  type              MovementType
  bookingDate       DateTime     @db.Date
  valueDate         DateTime     @db.Date
  amount            Decimal      @db.Decimal(10, 2)
  description       String
  /// Feature 47: `description` in lowercase and without diacritics, to search
  /// by text ignoring case and accents. It is a column GENERATED ALWAYS ...
  /// STORED created with raw SQL in the migration (Prisma 7 cannot express it):
  /// PostgreSQL computes it, so NO `data:` may ever write it -- an INSERT or an
  /// UPDATE mentioning it is rejected by PostgreSQL.
  descriptionSearch String?
  balanceAfter      Decimal?     @db.Decimal(10, 2)
  currency          String       @default("EUR")
  note              String?

  account       Account        @relation(fields: [accountId], references: [id])
  accountId     Int
  category      Category?      @relation(fields: [categoryId], references: [id])
  categoryId    Int?
  paymentMethod PaymentMethod?

  origin MovementOrigin @default(imported)
  status MovementStatus @default(pending_review)

  // Both legs of a transfer share it. Written by the transfer detection
  // (feature 40) and, since feature 44, also by the manual link endpoint.
  transferId String?

  // The transferId both legs carried until the human undid that pair (F44).
  // Detection never re-links two movements sharing the same non-null value;
  // everything else about them stays eligible. Overwritten by a later undo:
  // one movement remembers only its LAST undone pair (decisions.md #3).
  undoneTransferId String?

  // Position within its bookingDate (1 = first of the day). Fixes the intraday
  // order and is part of the dedup index key.
  daySequence Int?

  // The investment product this money went to. Nothing writes it yet: marking
  // a contribution is a later feature. It is NOT a source for Valuation.invested.
  // It still leaves the movement out of the income/expense totals, but the
  // general way to do that is `excludedFromTotals` below (feature 49).
  product   InvestmentProduct? @relation(fields: [productId], references: [id])
  productId Int?

  // Feature 49: the human marked this movement as not counting in the
  // income/expense totals (e.g. money moved into a deposit). It changes
  // neither the amount nor the account balance, and no importer, transfer
  // link or transfer detection writes it: only the two PATCH endpoints.
  excludedFromTotals Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Dedup of imported movements: PARTIAL unique index created with raw SQL in
  // the migration (Prisma 7 cannot express it in the schema).

  @@index([accountId, bookingDate, daySequence])
  @@index([transferId])
  @@index([productId])
  // Feature 47: filtering by category and by "uncategorized" is the main use of
  // the review screen.
  @@index([categoryId])
}

/// What every investment product has, whatever its type. One table only: the
/// deposit-specific columns live here and stay NULL for the other types.
model InvestmentProduct {
  id       Int                   @id @default(autoincrement())
  bank     String
  name     String
  type     InvestmentProductType
  currency String                @default("EUR")

  openedAt DateTime? @db.Date
  // NULL = still open. No `status` enum: a boolean derived from this date is a
  // second source of truth that ends up out of sync.
  closedAt DateTime? @db.Date

  // Deposit-specific part (NULL in fund / etf / managed_portfolio). Written
  // once when the deposit is signed; it does not fluctuate, so a deposit has
  // no Valuation rows (business rule watched by the service, ADR-012).
  principal    Decimal?  @db.Decimal(10, 2)
  // APR AS A PERCENTAGE: 2.7500 means 2.75 %, never a fraction.
  interestRate Decimal?  @db.Decimal(6, 4)
  expectedGain Decimal?  @db.Decimal(10, 2)
  maturityDate DateTime? @db.Date

  valuations       Valuation[]
  savingsSnapshots SavingsSnapshot[]
  movements        Movement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Natural key: the name is written by hand in the product file, so it is
  // stable. Reloading the same file upserts on it.
  @@unique([bank, name])
}

/// The periodic snapshot of a product that fluctuates. Every number is stored
/// as the file reports it; nothing here is ever computed (rule 4).
model Valuation {
  id        Int               @id @default(autoincrement())
  product   InvestmentProduct @relation(fields: [productId], references: [id])
  productId Int
  date      DateTime          @db.Date

  // `invested` lives in the snapshot, not in the product: it grows with the
  // monthly contributions, so it is a fact of the date.
  invested       Decimal  @db.Decimal(10, 2)
  // What it is worth today. It does NOT include uninvestedCash: the net worth
  // of a product is marketValue + uninvestedCash (ADR-012).
  marketValue    Decimal  @db.Decimal(10, 2)
  gain           Decimal? @db.Decimal(10, 2)
  gainPercent    Decimal? @db.Decimal(7, 4)
  uninvestedCash Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One snapshot per product and date. Reloading the same file overwrites it
  // (upsert): the last load wins, unlike the flow, where a duplicate is dropped.
  @@unique([productId, date])
}

/// The monthly photo of a remunerated account (feature 26, ADR-026). Twin of
/// `Valuation` in trade -- one row per product and date, reloading UPSERTs,
/// nothing is ever computed -- and different in contents: there is no market
/// value and no accumulated gain here, there is a balance that moves with what
/// came in, what went out and the interest paid.
///
/// The five amounts are NOT NULL because the parser demands all five and checks
/// that they add up: a file missing one never reaches this table.
model SavingsSnapshot {
  id        Int               @id @default(autoincrement())
  product   InvestmentProduct @relation(fields: [productId], references: [id])
  productId Int
  date      DateTime          @db.Date

  /// The balance the month started with, exactly as the file writes it.
  openingBalance Decimal @db.Decimal(10, 2)
  /// What came IN during the month, WITHOUT the interest.
  moneyIn        Decimal @db.Decimal(10, 2)
  /// What went OUT during the month.
  moneyOut       Decimal @db.Decimal(10, 2)
  /// The interest paid on `date`.
  interest       Decimal @db.Decimal(10, 2)
  /// The closing balance right after the payment.
  balance        Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One photo per product and date. Reloading the same month overwrites it
  // (upsert): the last load wins, like Valuation and unlike the flow.
  @@unique([productId, date])
}

/// A row of a statement file the parser could not interpret (feature 48).
/// It is NOT a movement: nothing about it reaches the Movement table.
model ImportUnparsedRow {
  id         Int                 @id @default(autoincrement())
  bank       String
  year       String
  fileName   String
  /// 1-based row number in the file, as UnparsedRow.row carries it.
  rowNumber  Int
  reason     String
  /// Feature 54: the three columns of the review. They are the human's: the
  /// import never writes them, not even when it stores the same row again.
  status     ImportWarningStatus @default(pending)
  note       String?
  reviewedAt DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  // Natural key: the file it came out of plus the row of that file. Reimporting
  // the same file updates the reason, it never adds a second row (R6). The
  // `map:` is mandatory: the default name goes past Postgres' 63-char limit.
  @@unique([bank, year, fileName, rowNumber], map: "ImportUnparsedRow_identity_key")
}

/// A descuadre found by one of the two checks of feature 32, kept as the FACT
/// it was when it was found: `computed` and `fromFile` are never recalculated,
/// so a stored warning can never end up saying something false (ADR-031).
model ImportBalanceMismatch {
  id          Int                 @id @default(autoincrement())
  bank        String
  year        String
  fileName    String
  account     Account             @relation(fields: [accountId], references: [id])
  accountId   Int
  /// The compared point; serialized as `date`, the name the report already uses.
  bookingDate DateTime            @db.Date
  /// 'per-line' | 'statement-balance', verbatim as the report writes it. A
  /// String and not an enum on purpose: the hyphen is not a valid Prisma enum
  /// identifier and the contract value must not be re-mapped in two places.
  check       String
  computed    Decimal             @db.Decimal(10, 2)
  fromFile    Decimal             @db.Decimal(10, 2)
  status      ImportWarningStatus @default(pending)
  note        String?
  reviewedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // `difference` is NOT stored: it is `computed − fromFile` and is derived when
  // serializing, so it cannot diverge from its two operands.
  @@unique([bank, year, fileName, accountId, bookingDate, check, computed, fromFile], map: "ImportBalanceMismatch_identity_key")
  @@index([status])
}
