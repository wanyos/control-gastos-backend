# Cadena de conexión a PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/gastos?schema=public"

# Puerto donde escucha el servidor Fastify
PORT=3000

# Nivel de log de Fastify (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Credenciales OAuth de Google Drive (las tres OBLIGATORIAS).
# Cómo obtenerlas: pasos manuales en specs/drive-connection/design.md §10.
# NUNCA pegues aquí valores reales: este archivo se versiona (solo placeholders).
GOOGLE_DRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret
GOOGLE_DRIVE_REFRESH_TOKEN=your-refresh-token

# Carpeta raíz notas-banco/ que creas tú a mano en Drive (OBLIGATORIA).
# El backend NO crea la raíz: cuelga de ella. Acepta el fileId pelado O la URL
# completa de la carpeta (https://drive.google.com/drive/folders/<ID>): el backend
# extrae el <ID> al arrancar. Cómo obtenerlo: specs/drive-structure/design.md §9.
# Solo placeholder aquí (se versiona).
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-notas-banco-folder-id

# Carpeta de Drive a la que `pnpm run db:backup` sube las copias de la base de
# datos y de la que `pnpm run db:restore` las lee (OPCIONAL: sin ella el servidor
# arranca igual; solo fallan esos dos comandos, diciendo qué falta).
# La creas tú a mano y va FUERA de notas-banco/: dentro, la importación la
# tomaría por un banco. Aquí va el identificador de la carpeta O su dirección
# completa (https://drive.google.com/drive/folders/<ID>); el NOMBRE de la carpeta
# no sirve. Solo placeholder aquí (se versiona).
GOOGLE_DRIVE_BACKUP_FOLDER_ID=your-backup-folder-id
