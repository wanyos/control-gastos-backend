{
  "name": "gastos-backend",
  "version": "1.0.0",
  "description": "Backend para control de gastos con Fastify, TypeScript y Prisma (PostgreSQL)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:categories": "tsx prisma/seed-categories.ts",
    "seed:category-rules": "tsx prisma/seed-category-rules.ts",
    "parse-file": "tsx scripts/parse-bank-file.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "fastify",
    "prisma",
    "postgres",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@googleapis/drive": "^27.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.90.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
